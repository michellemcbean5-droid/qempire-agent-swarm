# Q-Empire Mobile App Environment Variables
# Copy this to .env and fill in your values
# NEVER commit the actual .env file

# HuggingFace API (free tier: 10k requests/month)
# Get your token at: https://huggingface.co/settings/tokens
EXPO_PUBLIC_HF_API_KEY=your_huggingface_token_here

# PostHog Analytics (free tier: 1M events/month)
# Create project at: https://posthog.com
EXPO_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key_here
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Q-Empire Webhook API
# Local development: http://localhost:8080
# Production: https://api.qempire.app
EXPO_PUBLIC_WEBHOOK_URL=http://localhost:8080

# RevenueCat API Keys (set in app.json or native config)
# iOS: rc_apple_api_key_here
# Android: rc_google_api_key_here

# AdMob App IDs (set in app.json)
# iOS: ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
# Android: ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy

# Master Access Code (for owner Elite unlock)
# Set this securely in production, never commit
MASTER_ACCESS_CODE=QEMP2024ELITE
