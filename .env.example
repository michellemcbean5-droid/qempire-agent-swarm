# Q-Empire Agent Swarm Environment Variables
# Copy this to .env and fill in your values

# LLM API Key (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# GitHub (for deploying client websites)
GITHUB_TOKEN=ghp_your-token-here
GITHUB_USERNAME=your-github-username

# Google Sheets CRM
GOOGLE_CREDENTIALS_PATH=/app/credentials.json
GOOGLE_SHEET_ID=your-google-sheet-id

# Email (Gmail)
GMAIL_ADDRESS=michellemcbean5@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Webhook
WEBHOOK_PORT=8080
WEBHOOK_SECRET=your-webhook-secret

# Agent Config
POLL_INTERVAL=300
MAX_RETRIES=3

# Admin API key — required to access /admin/* and PATCH /agents/* endpoints
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=your-admin-api-key-here

# AI Credit controls
DAILY_CREDIT_CAP=500
CREDITS_PATH=/app/memory/credits.json

# Audit / flags storage
AUDIT_LOG_PATH=/app/memory/audit_log.json
FLAGS_PATH=/app/memory/feature_flags.json
