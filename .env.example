# Q-Empire Agent Swarm Environment Variables
#
# EASIEST WAY: don't edit this file. Start the API, open /admin in the app,
# create a password on first visit, then paste every key into one screen —
# they're saved here automatically. (This file is only for manual setup.)
#
# Copy this to .env and fill in your values

# Model for paid users — Kimi / Moonshot (OpenAI-compatible). Preferred if set.
KIMI_API_KEY=sk-your-moonshot-key-here
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5

# Credit economics (see docs/PRICING_ECONOMICS.md)
TOKENS_PER_CREDIT=4000
OUTPUT_WEIGHT=4.2
CREDIT_SELL_USD=0.0035

# Stripe billing — create these in your Stripe dashboard (test mode first)
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_CURRENT=price_xxx        # $14/mo · 4,000 credits
STRIPE_PRICE_REEF=price_xxx           # $28/mo · 8,000 credits
STRIPE_PRICE_DEEP_BLUE=price_xxx      # $140/mo · 40,000 credits
STRIPE_PRICE_PACK_5K=price_xxx        # 5,000 credit pack
STRIPE_PRICE_PACK_20K=price_xxx       # 20,000 credit pack

# Fallback LLM API Key (Anthropic Claude) — used only if no Kimi key is set
ANTHROPIC_API_KEY=sk-ant-your-key-here

# GitHub (for deploying client websites)
GITHUB_TOKEN=ghp_your-token-here
GITHUB_USERNAME=your-github-username

# Google Sheets CRM
GOOGLE_CREDENTIALS_PATH=/app/credentials.json
GOOGLE_SHEET_ID=your-google-sheet-id

# Email (Gmail)
GMAIL_ADDRESS=michellemcbean5@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Webhook
WEBHOOK_PORT=8080
WEBHOOK_SECRET=your-webhook-secret

# Agent Config
POLL_INTERVAL=300
MAX_RETRIES=3
