{
  "name": "qempire-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --coverage",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"]
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-notifications": "~0.29.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-updates": "~0.27.0",
    "expo-splash-screen": "~0.29.0",
    "expo-font": "~13.0.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-web": "~0.19.13",
    "react-dom": "18.3.1",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "react-native-screens": "~4.0.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.0",
    "react-native-svg": "15.8.0",
    "react-native-purchases": "^8.0.0",
    "react-native-google-mobile-ads": "^14.0.0",
    "react-native-async-storage": "^0.0.1",
    "@react-native-async-storage/async-storage": "2.1.0",
    "zustand": "^5.0.0",
    "react-native-mmkv": "^3.0.0",
    "lucide-react-native": "^0.460.0",
    "react-native-linear-gradient": "^2.8.0",
    "react-native-shimmer-placeholder": "^2.0.0",
    "react-native-skeleton-placeholder": "^5.2.0",
    "@sentry/react-native": "~6.0.0",
    "posthog-react-native": "^3.0.0",
    "react-native-share": "^11.0.0",
    "react-native-webview": "13.12.0",
    "react-native-markdown-display": "^7.0.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-haptic-feedback": "^2.3.0",
    "react-native-animatable": "^1.4.0",
    "react-native-modal": "^13.0.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-uuid": "^2.0.0",
    "date-fns": "^4.0.0",
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "@types/react-native": "~0.72.0",
    "typescript": "~5.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "@testing-library/react-native": "^12.0.0",
    "@testing-library/jest-native": "^5.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0"
  },
  "private": true
}
